import com.rameses.annotations.*;

class WaterAccountService {

	@DataContext("vw_water_account")
	def vwAcctEm;

	@DataContext("water_account")
	def acctEm;

	@DataContext("vw_water_bill")
	def vwBillEm;

	@DataContext("water_bill")
	def billEm;

	@DataContext("vw_water_batch_bill")
	def vwBatchBillEm;

	@DataContext("water_billgroup")
	def billgrpEm;


	@ProxyMethod
	public def addToBillGroup(def o ) {
		if(!o.acctid) throw new Exception("Please specify acctid for WaterAccountService.addToBillGroup");
		if(!o.billgroupid) throw new Exception("Please specify billgroupid for WaterAccountService.addToBillGroup");
		acctEm.find( [objid: o.acctid ] ).update( [billgroupid: o.billgroupid ]);
	}

	@ProxyMethod
	public def detachBillFromBatch( def o ) {
		if( !o.acctid ) throw new Exception("acctid is required");
		//detach latest open bill from batch 
		def lastBillid = vwAcctEm.find( [objid: o.acctid ] ).select("lastbillid").val();
		if( lastBillid ) {
			billEm.find( [objid: lastBillid] ).update( [batchid: "{NULL}" ] );	
		}
	}

	@ProxyMethod
	public def rejoinBillToBatch( def o ) {
		if( !o.acctid ) throw new Exception("acctid is required");
		//find acct billgroupid
		def acct = vwAcctEm.find( [objid: o.acctid ] ).first();
		if( !acct.lastbillid ) return null;

		def bill = vwBillEm.find( [objid: acct.lastbillid ] ).first();
		if ( !bill.batchid ) return null;

		def billgroup = billgrpEm.find( [objid: bill.billgroupid ] ).first();
		if(billgroup?.currentbatchid) {
			def batch = vwBatchBillEm.find( [objid: billgroup.currentbatchid] ).first();	
			if( batch.scheduleid != bill.scheduleid ) 
				throw new Exception("Current batch for the billgroup does not match the bill. Please check bill must be for " + batch.year + " " + batch.monthname );
			billEm.find( [objid: bill.objid] ).update( [batchid: batch.objid ] );	
		}
	}

	@ProxyMethod
	public def checkHasBillgroup( def o  ) {
		if( !o.acctid ) throw new Exception("acctid is required in WaterAccountService.checkHasBillgroup");
		def acct = vwAcctEm.find( [objid: o.acctid ] ).first();
		if(!acct.billgroupid) 
			throw new Exception("Please assign a billgroup to the account"); 
	}

	


}
