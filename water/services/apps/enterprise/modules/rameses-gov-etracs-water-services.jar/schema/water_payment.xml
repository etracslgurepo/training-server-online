<schema>
	<element tablename="water_payment">
		<field name="objid" primary="true" prefix="WTRPMT"/>

		<!-- reference bill being paid -->
		<field name="billid" required="true"/>

		<field name="refid" />
		<field name="refno" caption="Ref No"/>
		<field name="reftype"  required="true" caption="Ref Type"/>
		<field name="refdate"  type="date" caption="Ref Date"/>
		<field name="txnmode"  required="true" caption="Txn Mode"/>
		<field name="voided"  required="true" caption="Voided"/>
		<field name="amount" type="decimal"  required="true" caption="Amount"/>
		<field name="remarks" caption="Remarks"/>
		<field name="txnid" />

		<field name="payer_objid" />
		<field name="payer_name" />
		<field name="paidby" />
		<field name="paidbyaddress" />

		<field name="txnid" />
		<!-- 0=unposted 1=posted -->
		<field name="posted"  type="integer"/>
	</element>
</schema>
