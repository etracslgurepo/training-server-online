<schema>
	<element tablename="vw_water_txn">
		<field name="objid" primary="true"/>
		<field name="controlno" caption="App No" indexed="true" searchable="true"/>
		<field name="txntypeid" />
		<field name="remarks" />
		
		<complex name="info"  serializer="default" required="false"/>

		<field name="taskid" />
		
		<field name="task_state" />
		<field name="task_dtcreated" />
		<field name="task_startdate" />
		<field name="task_enddate" />
		<field name="task_assignee_objid" />
		<field name="task_assignee_name" />
		<field name="task_actor_objid" />
		<field name="task_actor_name" />
		<field name="task_title" />
		<field name="task_tracktime" />
		<field name="task_properties" />

		<field name="oldacctinfoid" />
		<field name="newacctinfoid" />

		<complex name="account" ref="water_account" jointype="many-to-one" includefields="acctno,billgroup.*" required="false">
			<key field="acctid" target="objid" />
		</complex>


		<complex name="txntype" ref="water_txntype" jointype="many-to-one" required="true">
			<key field="txntypeid" target="objid" />
		</complex>

		<complex name="acctinfo" ref="vw_water_account_info" jointype="many-to-one" required="false">
			<key field="acctinfoid" target="objid" />
		</complex>

		<field name="billid" />
		<field name="cashreceiptrefid" />		
	</element>
</schema>	

