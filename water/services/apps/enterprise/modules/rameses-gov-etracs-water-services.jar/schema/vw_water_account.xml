		<field name="notes" />

		<field name="acctgroupid" />
		<field name="acctgroup_name" searchable="true" indexed="true" caption="Account Group"/>
		<field name="acctgroup_fullpath" searchable="true" />
		<field name="acctgroup_sortorder" />

		<!-- this is used for cash receipt lookup. cashreceiptrefid is the standard field name for generic collection -->
		<field name="cashreceiptrefid" />
		
		<field name="schedulegroupid" />

