		<field name="amount" type="decimal" required="true"/>
		<field name="creditamt" type="decimal" required="true"/>
		<field name="remarks" />	
		<field name="unit" />
		<field name="auto" />
		<field name="unitrate" type="decimal"/>
		<field name="paymentid" />
	</element>
</schema>


