import com.rameses.annotations.*; 

class OnlineWaterMobileReadingService {

	@Service( dynamic=true )
	def dynaSvc; 


	@ProxyMethod
	public def compute( def param ) { 
		def svc = dynaSvc.lookup('WaterMobileReadingService'); 
		return svc.compute( param ); 
	}

	@ProxyMethod
	public def uploadReading( def param ) {
		def svc = dynaSvc.lookup('WaterMobileReadingService'); 
		return svc.uploadReading( param ); 
	}
}