app:
   env:
      "app.title" : "ETRACS 2.5 build 2.5.05.03-12 (${lgu_name}) OSCP"

      "obo.app.host": "${pub_app_server_ip}:8030"
      "obo.app.context": "enterprise"
      "obo.filemgmt.connection": "pub-ftpsite"

      "cloud-server.app.host": "${pub_app_server_ip}:8500"
      "cloud-server.app.cluster": "cloud-server"
      "cloud-server.app.context": "obo"

      "rpt.app.host": "${server_ip}:8070"
      "rpt.app.context": "etracs25"

   modules:
      - { order: 301, version: 2.07, file: "modules/obo/rameses-gov-etracs-obo.jar" }
      - { order: 302, version: 2.11, file: "modules/obo/rameses-gov-etracs-obo-building.jar" }
      - { order: 303, version: 2.05, file: "modules/obo/rameses-gov-etracs-obo-occupancy.jar" }
      - { order: 304, version: 2.05, file: "modules/obo/rameses-gov-etracs-obo-collection.jar" }
      - { order: 305, version: 2.05, file: "modules/obo/rameses-gov-etracs-obo-cloud.jar" }
      - { order: 306, version: 2.05, file: "modules/obo/rameses-gov-etracs-obo-shared.jar" }

      - { order: 307, version: 2.02, file: "modules/obo/rameses-gov-etracs-obo-rptis.jar" }
