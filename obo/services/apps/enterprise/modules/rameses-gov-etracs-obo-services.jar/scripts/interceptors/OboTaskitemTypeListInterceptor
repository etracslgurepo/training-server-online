import com.rameses.annotations.*; 

class OboTaskitemTypeListInterceptor { 

	@DataContext("obo_appclass")
	def appClassEm;


	@After(pattern="QueryService.getNodeList", eval="#{args[0]._schemaname == 'obo_taskitem_type' }")
	public void getNodeList(def evt) {
		def result = evt.result;
		appClassEm.where("1=1").select("objid").list().each {
			result << [title: it.objid];
		}
	}

	@Before(pattern="QueryService.getList", eval="#{args[0]._schemaname == 'obo_taskitem_type' }")
	public void loadList(def evt) {
		def o = evt.args[0];
		if( !o.node?.title ) return;

		def str = " appclassid = :type ";
		def m = [type: o.node.title ];

		//add to first position of where
		if( o.where ) {
			o.where[0] = str + " AND " + o.where[0];	
			o.where[1].putAll( m );
		}
		else {
			o.where = [str, m];
		}
	}

} 