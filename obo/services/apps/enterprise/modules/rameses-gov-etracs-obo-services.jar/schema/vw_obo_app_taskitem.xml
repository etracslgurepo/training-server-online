<schema>
	<element tablename="vw_obo_app_taskitem">
		<field name="objid" primary="true"/>

		<field name="appid" />
		<field name="typeid" />
		<field name="taskid" />
		<field name="sectionid" />
		<field name="org_objid" />
		<field name="app_task_state" />
		<field name="task_state" />
		<field name="task_dtcreated" />
		<field name="task_startdate" />
		<field name="task_enddate" />
		<field name="task_assignee_objid" />
		<field name="task_assignee_name" caption="Assignee"/>
		<field name="task_actor_objid" />
		<field name="task_actor_name" />
		<field name="task_title" />
		<field name="task_tracktime" />
		<field name="task_processname" />
		<field name="task_parentprocessname" />

		<!-- do not remove any of these are being used in obo_app_taskitem -->
		<field name="app_appno" caption="App No"/>
		<field name="app_applicant_name" searchable="true" indexed="true" caption="Applicant Name"/>
		<field name="app_title" searchable="true" indexed="true" caption="Title"/>
		<field name="app_trackingno" caption="Tracking No" searchable="true" indexed="true"/>
		<field name="app_task_state" />
		<field name="app_processname" />
		<field name="app_schemaname" />
		<field name="app_appclassid" />

		<complex name="type" ref="obo_taskitem_type" jointype="many-to-one" required="true">
			<key field="typeid" target="objid" />
		</complex>	

		<field name="revision" caption="Revision" type="integer"/>
	</element>
</schema>	



