<schema>
	<element tablename="vw_obo_app">
		<field name="objid" primary="true"/>
		<field name="appclassid" />
		<field name="appclass" />

		<!-- this is temporary solution because appclass might be used. This is an oversight in design -->
		<complex name="appclassinfo" ref="obo_appclass" jointype="many-to-one" required="true">
			<key field="appclassid" target="objid" />
		</complex>	

		<field name="appno" indexed="true" searchable="true" caption="App No"/>
		<field name="trackingno" indexed="true" searchable="true" caption="Tracking No"/>
		<field name="title" indexed="true" searchable="true" caption="Project Title"/>
		<field name="applicant_name" indexed="true" searchable="true" caption="Applicant Name"/>
		<field name="applicant_address_text"/>
		<field name="applicant_profileid" />
		<field name="applicant_email" />
		<field name="applicant_mobileno" />

		<field name="location_text"  caption="Location"/>
		<field name="task_state" />

		<!-- dont remove this is used -->
		<field name="processname" />		
		<field name="task_assignee_objid" />

		<field name="doctitle" />
		<field name="doctypeid" />
		<field name="schemaname" />
		<field name="contact_name" />		
		<field name="contact_detail" />				
		<field name="contact_email" />
		<field name="contact_mobileno" />
		<field name="apptype" />		
		<field name="txntype" />

		<field name="orgcode" />
		<field name="appdate" type="date"/>
		<field name="applicantid"/>
		<field name="createdby_objid" />
		<field name="createdby_name" />
		<field name="dtcreated" type="timestamp"/>	
		<field name="billid" />

		<field name="bill_billno" />
		<field name="bill_billdate" />
		<field name="bill_state" />
		<field name="bill_amount" />

		<field name="inspectiondate" />
	</element>
</schema>

