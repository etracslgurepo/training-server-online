					</textElement>
				<text><![CDATA[&nbsp;&nbsp;&nbsp;&nbsp; The owner/lessee shall properly maintain the electrical installation to ensure its safe
condition/operation.]]></text>
				</staticText>
				<staticText>
					<reportElement
						x="393"
						y="364"
						width="420"
