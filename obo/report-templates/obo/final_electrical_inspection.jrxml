						<font fontName="Copperplate Gothic Light" pdfFontName="Helvetica" size="8" isBold="false" isItalic="false"/>
					</textElement>
				<text><![CDATA[&nbsp;&nbsp;&nbsp;&nbsp; No change, addition or alteration deviating from the original electrical plans shall be made without appropriate permit.]]></text>
				</staticText>
				<staticText>
